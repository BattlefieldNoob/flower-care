{
  "name": "flower-care-rpi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/flower-care-rpi/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/flower-care-rpi",
        "format": ["cjs"],
        "bundle": false,
        "main": "apps/flower-care-rpi/src/main.ts",
        "tsConfig": "apps/flower-care-rpi/tsconfig.app.json",
        "assets": ["apps/flower-care-rpi/src/assets"],
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "generateLockfile": true,
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "build-bun": {
      "executor": "@nx-bun/nx:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "entrypoints": ["apps/flower-care-rpi/src/main.ts"],
        "outputPath": "dist/apps/flower-care-rpi",
        "tsConfig": "apps/flower-care-rpi/tsconfig.app.json",
        "smol": false,
        "minify": true,
        "bun": true,
        "external": ["miflora"],
        "sourcemap": "external",
        "assets": ["apps/flower-care-rpi/src/assets"]
      },
      "configurations": {
        "development": {
          "minify": false,
          "sourcemap": "inline",
          "splitting": true
        },
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "flower-care-rpi:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "flower-care-rpi:build:development"
        },
        "production": {
          "buildTarget": "flower-care-rpi:build:production"
        }
      }
    },
    "serve-bun": {
      "executor": "@nx-bun/nx:run",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "flower-care-rpi:build",
        "tsConfig": "apps/flower-care-rpi/tsconfig.app.json",
        "watch": true,
        "bun": true,
        "smol": false
      },
      "configurations": {
        "development": {
          "buildTarget": "flower-care-rpi:build:development"
        },
        "production": {
          "buildTarget": "flower-care-rpi:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/flower-care-rpi/jest.config.ts"
      }
    },
    "container": {
      "executor": "@nx-tools/nx-container:build",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "engine": "docker",
        "cache-from": ["type=gha"],
        "cache-to": ["type=gha,mode=max"],
        "platforms": ["linux/amd64", "linux/arm64"],
        "metadata": {
          "images": ["ghcr.io/battlefieldnoob/flower-care-rpi"],
          "tags": [
            "type=schedule",
            "type=ref,event=branch",
            "type=ref,event=tag",
            "type=ref,event=pr",
            "type=sha,prefix=sha-",
            "type=semver,pattern={{version}}",
            "type=semver,pattern={{major}}.{{minor}}",
            "type=semver,pattern={{major}}"
          ]
        },
        "push": true
      },
      "configurations": {
        "development": {
          "platforms": ["linux/amd64"],
          "metadata": {
            "images": [
              "flower-care-rpi",
              "ghcr.io/battlefieldnoob/flower-care-rpi"
            ]
          },
          "push": false
        },
        "production": {}
      }
    }
  }
}
